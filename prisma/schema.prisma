// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([username])
  @@index([isActive])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BackupSchedule {
  id        String    @id
  enabled   Boolean   @default(false)
  frequency String    @default("DAILY")
  timeOfDay String    @default("17:00")
  lastRunAt DateTime?
  nextRunAt DateTime?
  updatedAt DateTime  @updatedAt
}

model Student {
  id               String           @id @default(cuid())
  fullName         String
  admissionDate    DateTime?
  birthDate        DateTime?
  gradeSection     String
  diagnosis        String
  chronologicalAge String?
  teacherName      String
  status           String           @default("IN_PROCESS")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  diagnosticEvaluation DiagnosticEvaluation?
  behaviorEvaluation   BehaviorEvaluation?
  inattentionEvaluation InattentionEvaluation?
  mathEvaluation       MathEvaluation?
  pedagogicalPlans     PedagogicalPlan[]
  progressRecords      ProgressRecord[]
  attachments          Attachment[]

  @@index([fullName])
  @@index([gradeSection])
  @@index([diagnosis])
  @@index([teacherName])
  @@index([status])
  @@index([updatedAt])
}

model DiagnosticEvaluation {
  id                                      String   @id @default(cuid())
  studentId                               String   @unique
  evaluationDate                          DateTime?
  evaluatorName                           String?
  uppercaseLowercaseGraphemeObservation   String?
  simpleSyllablesObservation              String?
  inverseSyllablesObservation             String?
  mixedSyllablesObservation               String?
  compoundSyllablesObservation            String?
  monosyllabicWordsObservation            String?
  bisyllabicWordsObservation              String?
  trisyllabicWordsObservation             String?
  shortSentencesObservation               String?
  longSentencesObservation                String?
  paragraphsObservation                   String?
  shortStoriesObservation                 String?
  generalObservations                     String?
  createdAt                               DateTime @default(now())
  updatedAt                               DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model BehaviorEvaluation {
  id                             String         @id @default(cuid())
  studentId                      String         @unique
  behaviorStatus                 String         @default("OBSERVATION")
  attitudeObservation            String?
  collaborationObservation       String?
  instructionsObservation        String?
  frustrationToleranceObservation String?
  teacherInteractionObservation  String?
  relevantBehaviorObservation    String?
  generalObservations            String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model InattentionEvaluation {
  id                              String         @id @default(cuid())
  studentId                       String         @unique
  attentionLevel                  String         @default("MEDIUM")
  easilyDistractedObservation     String?
  maintainAttentionObservation    String?
  instructionRepetitionObservation String?
  changesActivityObservation      String?
  constantSupportObservation      String?
  generalObservations             String?
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model MathEvaluation {
  id                          String   @id @default(cuid())
  studentId                   String   @unique
  numberRecognitionObservation String?
  countingObservation         String?
  basicOperationsObservation  String?
  problemSolvingObservation   String?
  quantityConceptObservation  String?
  sequencesPatternsObservation String?
  geometricShapesObservation  String?
  generalObservations         String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model PedagogicalPlan {
  id           String    @id @default(cuid())
  studentId    String
  partial      String
  title        String
  description  String?
  objectives   String?
  strategies   String?
  resources    String?
  creationDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([studentId])
  @@index([partial])
}

model ProgressRecord {
  id                String         @id @default(cuid())
  studentId         String
  partial           String
  recordDate        DateTime?
  observedProgress  String?
  difficulties      String?
  appliedStrategies String?
  recommendations   String?
  classroomRecommendations String?
  progressStatus    String         @default("NOT_STARTED")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([partial])
  @@index([progressStatus])
}

model Attachment {
  id         String   @id @default(cuid())
  studentId  String
  planId     String?
  fileName   String
  fileType   String
  fileUrl    String
  uploadedAt DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan    PedagogicalPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([planId])
}
